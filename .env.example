# Generate a long random value for deployed environments.
SECRET_KEY=replace-with-a-long-random-secret

# Optional OpenAI-compatible API. Keep the key on the server; never put it in JS.
OPENAI_API_KEY=replace-with-your-own-key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Optional for a trusted reverse-proxy/tunnel deployment. Include scheme and port if needed.
PUBLIC_APP_URL=
PORT=5000

# Set to 1 only when serving the site over trusted HTTPS.
SESSION_COOKIE_SECURE=0
